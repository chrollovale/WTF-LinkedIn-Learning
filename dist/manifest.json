{
  "manifest_version": 3,
  "name": "WTF LinkedIn Learning",
  "version": "1.1.0",
  "description": "Aniket: Dear LinkedIn Learning, what the fuck?",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "icons": {
    "16": "icon/icon16.png",
    "32": "icon/icon32.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon/icon16.png",
      "32": "icon/icon32.png",
      "48": "icon/icon48.png",
      "128": "icon/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/learning/*"
      ],
      "js": [
        "content-bridge.js"
      ]
    },
    {
      "matches": [
        "https://*.linkedin.com/learning/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "https://*.linkedin.com/*"
      ]
    }
  ]
}
